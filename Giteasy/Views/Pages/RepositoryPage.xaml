<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Giteasy.Views.Pages.RepositoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row0: ヘッダー ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="リポジトリ" Style="{StaticResource TitleTextBlockStyle}"/>
                <Border CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock x:Name="CurrentBranchText" Text="未設定" FontSize="12" Foreground="White"/>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Click="Refresh_Click" ToolTipService.ToolTip="すべて更新">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- ═══ Row1: ツールバー ═══ -->
        <Grid Grid.Row="1" CornerRadius="8" Padding="12,8"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 同期ボタン群 -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Click="Fetch_Click" ToolTipService.ToolTip="Fetch: リモートの最新情報を取得">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" FontSize="14"/>
                        <TextBlock Text="Fetch"/>
                    </StackPanel>
                </Button>
                <Button Click="Pull_Click" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Pull: リモートの変更をローカルに反映">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="14"/>
                        <TextBlock Text="Pull"/>
                    </StackPanel>
                </Button>
                <Button Click="Push_Click" ToolTipService.ToolTip="Push: ローカルの変更をリモートに送信">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE898;" FontSize="14"/>
                        <TextBlock Text="Push"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 区切り -->
            <Border Grid.Column="1" Width="1" Margin="8,0"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

            <!-- ブランチ作成 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <TextBox x:Name="NewBranchBox" PlaceholderText="新しいブランチ名"
                         MinWidth="160" VerticalAlignment="Center"/>
                <Button Click="CreateBranch_Click" ToolTipService.ToolTip="ブランチ作成（コミット選択時はそこから作成）">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                        <TextBlock Text="作成"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ステータス -->
            <TextBlock x:Name="SyncStatusText" Grid.Column="3"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <!-- ═══ Row2: メインエリア（ブランチ一覧 | 履歴グラフ）═══ -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: ブランチ一覧 -->
            <Grid Grid.Column="0" CornerRadius="8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="ブランチ" Grid.Row="0" Padding="12,8"
                           FontWeight="SemiBold" FontSize="13"/>

                <ListView x:Name="BranchListView" Grid.Row="1" Padding="4"
                          SelectionMode="Single"
                          SelectionChanged="BranchList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="6,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{Binding Icon}" FontSize="14"
                                          VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                    <TextBlock Text="{Binding SyncStatusText}"
                                               FontSize="10"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Visibility="{Binding IsSynced}"/>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="3" Padding="5,1"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsHead}"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="現在" FontSize="10" Foreground="White"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- ブランチ操作ボタン -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Padding="8,6"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            CornerRadius="0,0,8,8">
                    <Button x:Name="CheckoutBtn" Content="切替" FontSize="12"
                            Click="Checkout_Click" IsEnabled="False"
                            ToolTipService.ToolTip="選択ブランチにチェックアウト"/>
                    <Button x:Name="MergeBtn" Content="マージ" FontSize="12"
                            Click="Merge_Click" IsEnabled="False"
                            ToolTipService.ToolTip="選択ブランチを現在のブランチにマージ"/>
                    <Button x:Name="DeleteBranchBtn" Content="削除" FontSize="12"
                            Click="DeleteBranch_Click" IsEnabled="False"
                            Foreground="#F44336"
                            ToolTipService.ToolTip="選択ブランチを削除"/>
                </StackPanel>
            </Grid>

            <!-- 右: 履歴グラフ -->
            <Grid Grid.Column="1" CornerRadius="8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="コミット履歴" Grid.Row="0" Padding="12,8"
                           FontWeight="SemiBold" FontSize="13"/>

                <ListView x:Name="CommitListView" Grid.Row="1" Padding="4"
                          SelectionMode="Single"
                          SelectionChanged="CommitList_SelectionChanged"
                          ContainerContentChanging="CommitList_ContainerContentChanging">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Canvas x:Name="GraphCanvas" Grid.Column="0"
                                        Width="60" Height="40" VerticalAlignment="Center"/>
                                <ItemsControl x:Name="RefLabels" Grid.Column="1"
                                              VerticalAlignment="Center" Margin="0,0,8,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Grid.Column="2" Text="{Binding Commit.Message}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding Commit.AuthorName}"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="12,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding Commit.ShortSha}"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           FontFamily="Consolas"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing x:Name="LoadingRing" Grid.Row="1"
                              Width="40" Height="40"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- ═══ Row3: フッター（コミット操作）═══ -->
        <Grid Grid.Row="3" CornerRadius="8" Padding="12,8"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectedCommitText" Text="コミットを選択してください"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button x:Name="CreateBranchFromCommitBtn" Grid.Column="1"
                    Content="ブランチ作成" Margin="8,0"
                    Click="CreateBranchFromCommit_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="選択したコミットから新しいブランチを作成"/>
            <Button x:Name="RevertBtn" Grid.Column="2"
                    Content="Revert" Foreground="#F44336"
                    Click="Revert_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="選択したコミットを取り消し"/>
        </Grid>
    </Grid>
</Page>
