<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Giteasy.Views.Pages.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <TextBlock Text="リモートとの同期" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0"/>

        <!-- 同期操作カード群 -->
        <StackPanel Grid.Row="1" Spacing="4">

            <!-- Pull カード -->
            <Grid CornerRadius="8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" Padding="20,16"
                  ToolTipService.ToolTip="リモートリポジトリの最新の変更をローカルに反映します。">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE896;" FontSize="22" Margin="0,0,14,0"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Pull" FontWeight="SemiBold" FontSize="15"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="実行" MinWidth="80"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Pull_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- Push カード -->
            <Grid CornerRadius="8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" Padding="20,16"
                  ToolTipService.ToolTip="ローカルでコミットした変更をリモートリポジトリに送信します。">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE898;" FontSize="22" Margin="0,0,14,0"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Push" FontWeight="SemiBold" FontSize="15"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="実行" MinWidth="80"
                        Click="Push_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- Fetch カード -->
            <Grid CornerRadius="8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" Padding="20,16"
                  ToolTipService.ToolTip="リモートの最新情報を確認します。ローカルのファイルは変更されません。">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE895;" FontSize="22" Margin="0,0,14,0"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Fetch" FontWeight="SemiBold" FontSize="15"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="実行" MinWidth="80"
                        Click="Fetch_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- ステータス -->
            <TextBlock x:Name="StatusText" Text=""
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,0"/>

            <!-- ローディングインジケーター -->
            <ProgressBar x:Name="SyncProgress" IsIndeterminate="False"
                         Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Page>
