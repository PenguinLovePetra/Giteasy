<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Giteasy.Views.Pages.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ステータス" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock x:Name="StatusText" Text="" 
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="更新" Click="Refresh_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="None" Key="F5"/>
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ファイル一覧 -->
        <Grid Grid.Row="1" CornerRadius="8"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" Padding="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ファイル操作ツールバー -->
            <Grid Grid.Row="0" Padding="12,8" 
                  Background="{ThemeResource LayerFillColorAltBrush}"
                  CornerRadius="8,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="全選択" Click="SelectAll_Click" 
                            Style="{StaticResource AccentButtonStyle}"/>
                    <Button Content="選択解除" Click="DeselectAll_Click"/>
                </StackPanel>
                <Button Grid.Column="2" Click="DiscardChanges_Click"
                        ToolTipService.ToolTip="選択したファイルの変更を取り消します"
                        Foreground="#F44336">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        <TextBlock Text="変更を取消"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ファイルリスト -->
            <ListView x:Name="FileListView" Grid.Row="1"
                      Padding="4" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding FilePath}" 
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="2" CornerRadius="4" Padding="8,2"
                                    Background="{Binding StatusColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    Opacity="0.85">
                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- ファイルなしの表示 -->
            <StackPanel x:Name="EmptyState" Grid.Row="1" 
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" Spacing="8">
                <FontIcon Glyph="&#xE930;" FontSize="48"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="変更されたファイルはありません" 
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ローディング -->
            <ProgressRing x:Name="LoadingRing" Grid.Row="1"
                          IsActive="False" Width="40" Height="40"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- コミットエリア -->
        <Grid Grid.Row="2" CornerRadius="8"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="CommitMessageBox" Grid.Row="0"
                     PlaceholderText="コミットメッセージを入力してください（例: ログイン画面のレイアウトを修正）"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="60" MaxHeight="120"/>
            <Button Grid.Row="1" Content="コミット" Margin="0,12,0,0"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="Commit_Click" MinWidth="120"/>
        </Grid>
    </Grid>
</Page>
