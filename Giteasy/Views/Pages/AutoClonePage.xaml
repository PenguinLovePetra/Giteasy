<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Giteasy.Views.Pages.AutoClonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="自動クローン" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="監視ディレクトリに新しい bare リポジトリが作成されると、自動でクローンしてプロジェクトに登録します。"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- 設定パネル -->
        <StackPanel Grid.Row="1" Spacing="16">
            <!-- 監視ディレクトリ -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WatchDirBox"
                         Header="監視ディレクトリ（bare リポジトリが作られるフォルダ）"
                         PlaceholderText="例: C:\Repos\RemoteBare"
                         Text="{x:Bind _vm.WatchDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" VerticalAlignment="Bottom"
                        Click="BrowseWatchDir_Click"
                        ToolTipService.ToolTip="フォルダを選択">
                    <FontIcon Glyph="&#xE838;" FontSize="16"/>
                </Button>
            </Grid>

            <!-- クローン先ディレクトリ -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CloneDirBox"
                         Header="クローン先ディレクトリ（作業フォルダの親ディレクトリ）"
                         PlaceholderText="例: C:\Projects"
                         Text="{x:Bind _vm.CloneBaseDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" VerticalAlignment="Bottom"
                        Click="BrowseCloneDir_Click"
                        ToolTipService.ToolTip="フォルダを選択">
                    <FontIcon Glyph="&#xE838;" FontSize="16"/>
                </Button>
            </Grid>

        <!-- 監視コントロール -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CheckNowButton"
                        Click="CheckNow_Click"
                        IsEnabled="{x:Bind _vm.IsChecking, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                        MinWidth="140">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE895;" FontSize="14"/>
                        <TextBlock Text="今すぐ確認"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Text="{x:Bind _vm.StatusMessage, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <ProgressRing IsActive="{x:Bind _vm.IsChecking, Mode=OneWay}" 
                                  Width="16" Height="16" 
                                  VerticalAlignment="Center"
                                  Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- クローン履歴 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="クローン履歴" Grid.Row="0"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,8,0,8"/>

            <!-- 空の場合 -->
            <StackPanel x:Name="EmptyHistoryPanel" Grid.Row="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8" Visibility="Visible">
                <FontIcon Glyph="&#xE823;" FontSize="36"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="まだクローン履歴はありません"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 履歴リスト -->
            <ListView x:Name="HistoryListView" Grid.Row="1"
                      Visibility="Collapsed"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10" ColumnSpacing="12"
                              CornerRadius="6" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- アイコン -->
                            <Border CornerRadius="6" Width="36" Height="36"
                                    Background="{ThemeResource LayerFillColorAltBrush}">
                                <FontIcon Glyph="&#xE896;" FontSize="16"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>

                            <!-- 情報 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding RepoName}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding ClonePath}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- タイムスタンプ -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Status}"
                                           FontSize="12"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding TimestampText}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
