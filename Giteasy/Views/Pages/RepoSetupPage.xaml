<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Giteasy.Views.Pages.RepoSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <TextBlock Text="リポジトリのセットアップ" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0"/>

        <!-- ローディング -->
        <ProgressBar x:Name="ProgressIndicator" Grid.Row="1"
                     IsIndeterminate="False" Visibility="Collapsed"/>

        <!-- タブ切替 -->
        <Pivot Grid.Row="2">

            <!-- ═══════════════ 新規作成タブ ═══════════════ -->
            <PivotItem>
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="新規作成 (Init)"/>
                    </StackPanel>
                </PivotItem.Header>
                <ScrollViewer Padding="0,16,0,0">
                    <StackPanel Spacing="4" MaxWidth="600" HorizontalAlignment="Left">

                        <!-- ステップ 1: ローカルパス -->
                        <Grid CornerRadius="8"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" Padding="20"
                              ToolTipService.ToolTip="Git で管理したいプロジェクトのフォルダを選んでください。空でも既存でもOKです。">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border CornerRadius="12" Width="24" Height="24"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                                                   FontSize="12" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="フォルダを選択" FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InitLocalPathBox" 
                                             PlaceholderText="C:\Users\you\my-project"/>
                                    <Button Grid.Column="1" Content="参照"
                                            Margin="8,0,0,0" Click="BrowseInitPath_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- ステップ 2: リモートURL (任意) -->
                        <Grid CornerRadius="8"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" Padding="20"
                              ToolTipService.ToolTip="サーバー上のリポジトリURLを入力すると、自動で接続 (origin) を設定します。後からでも設定できます。">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border CornerRadius="12" Width="24" Height="24"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold"
                                                   FontSize="12" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="リモートURL（任意）" FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox x:Name="InitRemoteUrlBox" 
                                         PlaceholderText="https://github.com/user/repo.git"/>
                            </StackPanel>
                        </Grid>

                        <!-- bare 自動初期化オプション -->
                        <Grid CornerRadius="8"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" Padding="20"
                              ToolTipService.ToolTip="リモートURLがローカルパスの場合、そのパスにGitリポジトリがなければベアリポジトリを自動作成します">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="リモートの自動初期化" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="ローカルパスにリポジトリがない場合、bareリポジトリを自動作成"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoInitBareToggle" Grid.Column="1" 
                                              IsOn="True" OnContent="ON" OffContent="OFF"/>
                            </Grid>
                        </Grid>

                        <!-- 実行ボタン -->
                        <Button Content="リポジトリを作成する" MinWidth="200"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="InitRepo_Click" Margin="0,8,0,0"/>

                        <!-- ステータス -->
                        <TextBlock x:Name="StatusText" Text=""
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ═══════════════ クローンタブ ═══════════════ -->
            <PivotItem>
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14"/>
                        <TextBlock Text="クローン (Clone)"/>
                    </StackPanel>
                </PivotItem.Header>
                <ScrollViewer Padding="0,16,0,0">
                    <StackPanel Spacing="4" MaxWidth="600" HorizontalAlignment="Left">

                        <!-- ステップ 1: リモートURL -->
                        <Grid CornerRadius="8"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" Padding="20"
                              ToolTipService.ToolTip="コピーしたいリモートリポジトリのURLまたはネットワークパスを入力してください。">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border CornerRadius="12" Width="24" Height="24"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                                                   FontSize="12" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="クローン元のURL" FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox x:Name="CloneRemoteUrlBox" 
                                         PlaceholderText="https://github.com/user/repo.git"/>
                            </StackPanel>
                        </Grid>

                        <!-- ステップ 2: ローカルパス -->
                        <Grid CornerRadius="8"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" Padding="20"
                              ToolTipService.ToolTip="リポジトリの内容をダウンロードするフォルダを選んでください。">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border CornerRadius="12" Width="24" Height="24"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold"
                                                   FontSize="12" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="保存先フォルダ" FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CloneLocalPathBox" 
                                             PlaceholderText="C:\Users\you\cloned-project"/>
                                    <Button Grid.Column="1" Content="参照"
                                            Margin="8,0,0,0" Click="BrowseClonePath_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- 実行ボタン -->
                        <Button Content="クローンを実行する" MinWidth="200"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="CloneRepo_Click" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
