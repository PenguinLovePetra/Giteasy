<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Giteasy.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="コミット履歴" Style="{StaticResource TitleTextBlockStyle}"/>
            <Button Grid.Column="1" Content="更新" Click="Refresh_Click" VerticalAlignment="Top"/>
        </Grid>

        <!-- コミットログ一覧 -->
        <Grid Grid.Row="1" CornerRadius="8"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView x:Name="CommitListView" Grid.Row="0" Padding="4"
                      SelectionMode="Single"
                      SelectionChanged="CommitList_SelectionChanged"
                      ContainerContentChanging="CommitList_ContainerContentChanging">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0" ColumnSpacing="0" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="GraphColumn" Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- グラフ Canvas -->
                            <Canvas x:Name="GraphCanvas" Grid.Column="0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                            <!-- Refラベル + メッセージ + 作者 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0"
                                        Orientation="Horizontal" Margin="4,0,8,0">
                                <!-- Refラベルはコードビハインドで動的に追加 -->
                                <ItemsControl x:Name="RefLabels">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Commit.Message}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Border CornerRadius="4" Padding="6,2"
                                            Background="{ThemeResource LayerFillColorAltBrush}">
                                        <TextBlock Text="{Binding Commit.ShortSha}" FontFamily="Consolas"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Commit.AuthorName}" FontSize="11"
                                               VerticalAlignment="Center" Opacity="0.6"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 日時 -->
                            <TextBlock Grid.Column="3" Text="{Binding Commit.FormattedDate}"
                                       FontSize="11" VerticalAlignment="Center" Margin="8,0,8,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.6"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="12,8"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="0,0,8,8">
                <Button x:Name="RevertBtn" Click="Revert_Click"
                        IsEnabled="False" Foreground="#FF9800"
                        ToolTipService.ToolTip="選択したコミットの変更を取り消す新しいコミットを作成します。履歴は消えないので安全です。">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14"/>
                        <TextBlock Text="Revert"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ProgressRing x:Name="LoadingRing" Grid.Row="0"
                          IsActive="False" Width="40" Height="40"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
