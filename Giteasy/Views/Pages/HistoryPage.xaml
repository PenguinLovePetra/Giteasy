<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Giteasy.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="コミット履歴" Style="{StaticResource TitleTextBlockStyle}"/>
            <Button Grid.Column="1" Content="更新" Click="Refresh_Click" VerticalAlignment="Top"/>
        </Grid>

        <!-- コミットログ一覧 -->
        <Grid Grid.Row="1" CornerRadius="8"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView x:Name="CommitListView" Grid.Row="0" Padding="4"
                      SelectionMode="Single"
                      SelectionChanged="CommitList_SelectionChanged"
                      ContainerContentChanging="CommitList_ContainerContentChanging">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,6" ColumnSpacing="0" MinHeight="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- グラフ Canvas -->
                            <Canvas x:Name="GraphCanvas" Grid.Column="0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                            <!-- SHA -->
                            <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="4,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource LayerFillColorAltBrush}">
                                <TextBlock Text="{Binding Commit.ShortSha}" FontFamily="Consolas"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>

                            <!-- メッセージ & 作者 & Ref -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2"
                                        Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <!-- Refラベルはコードビハインドで動的に追加 -->
                                    <ItemsControl x:Name="RefLabels">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Commit.Message}" TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Commit.AuthorName}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <!-- 日時 -->
                            <TextBlock Grid.Column="3" Text="{Binding Commit.FormattedDate}"
                                       FontSize="12" VerticalAlignment="Center" Margin="8,0,4,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Revert ボタン -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="12,8"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="0,0,8,8">
                <Button x:Name="RevertBtn" Click="Revert_Click"
                        IsEnabled="False" Foreground="#FF9800">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14"/>
                        <TextBlock Text="このコミットを取り消す（Revert）"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="RevertHint" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="← 取り消したいコミットを選択してください"/>
            </StackPanel>

            <ProgressRing x:Name="LoadingRing" Grid.Row="0"
                          IsActive="False" Width="40" Height="40"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
