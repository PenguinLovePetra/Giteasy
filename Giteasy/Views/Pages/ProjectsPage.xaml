<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Giteasy.Views.Pages.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="プロジェクト" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="登録済みのリポジトリ一覧です。クリックして切り替えできます。"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- プロジェクト一覧 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- リストが空の場合 -->
            <StackPanel x:Name="EmptyPanel" Grid.Row="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" Visibility="Collapsed">
                <FontIcon Glyph="&#xE8B7;" FontSize="48"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="まだプロジェクトが登録されていません"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="セットアップから新しいリポジトリを追加してください"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center"/>
                <Button x:Name="GoToSetupBtn" Click="GoToSetup_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="セットアップへ"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- プロジェクトリスト -->
            <ListView x:Name="ProjectListView" Grid.Row="0"
                      SelectionMode="Single"
                      SelectionChanged="ProjectList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,14" ColumnSpacing="16"
                              CornerRadius="6" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- アイコン -->
                            <Border CornerRadius="8" Width="40" Height="40"
                                    Background="{ThemeResource LayerFillColorAltBrush}">
                                <FontIcon Glyph="&#xE8B7;" FontSize="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>

                            <!-- 情報 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           FontSize="14"/>
                                <TextBlock Text="{Binding LocalPath}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding RemoteUrl}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding RemoteUrl, Converter={StaticResource StringVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- 最終使用 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                        HorizontalAlignment="Right" Spacing="2">
                                <TextBlock Text="最終使用"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Right">
                                    <Run Text="{Binding LastOpenedAt}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- アクションバー -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                        Padding="12,10"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        CornerRadius="8" Margin="0,8,0,0">
                <Button x:Name="OpenBtn" Click="Open_Click" IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                        <TextBlock Text="開く"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteBtn" Click="Delete_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        <TextBlock Text="一覧から削除"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
