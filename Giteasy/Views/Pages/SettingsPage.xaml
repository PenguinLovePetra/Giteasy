<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Giteasy.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <ScrollViewer Padding="0">
        <StackPanel Spacing="4" MaxWidth="700" HorizontalAlignment="Left">

            <!-- ヘッダー -->
            <TextBlock Text="設定" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16"/>

            <!-- ═════ テーマ ═════ -->
            <Grid CornerRadius="8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" Padding="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE771;" FontSize="20" Margin="0,0,14,0"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="テーマ" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="ThemeCombo" Grid.Column="2" MinWidth="160"
                          VerticalAlignment="Center"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="ThemeCombo_SelectionChanged"/>
            </Grid>

            <!-- ═════ Git エンジン ═════ -->
            <Grid CornerRadius="8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" Padding="16"
                  ToolTipService.ToolTip="PC内のgit.exeを使うか、同梱のLibGit2Sharpを使うかを選択します。git.exeはSSH認証やクレデンシャルヘルパーが利用可能です。">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE756;" FontSize="20" Margin="0,0,14,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Git エンジン" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="BackendCombo" Grid.Column="2" MinWidth="200"
                                  VerticalAlignment="Center"
                                  SelectionChanged="BackendCombo_SelectionChanged"/>
                    </Grid>
                    <TextBlock x:Name="GitExePathText" Text=""
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- ═════ ユーザー情報 ═════ -->
            <Grid CornerRadius="8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" Padding="16"
                  ToolTipService.ToolTip="コミットに記録される名前とメールアドレスです">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE77B;" FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="ユーザー情報" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="UserNameBox" Header="名前"
                             PlaceholderText="例: 山田太郎"/>
                    <TextBox x:Name="UserEmailBox" Header="メールアドレス"
                             PlaceholderText="例: yamada@example.com"/>
                </StackPanel>
            </Grid>

            <!-- 保存ボタン -->
            <Button Content="設定を保存する" MinWidth="140"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="Save_Click" Margin="0,12,0,0"/>

            <!-- ステータス -->
            <TextBlock x:Name="StatusText" Text=""
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
